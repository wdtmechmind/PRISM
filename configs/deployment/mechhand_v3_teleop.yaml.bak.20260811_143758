rpi_udp:
  host: 0.0.0.0
  port: 60701

daemon:
  host: 127.0.0.1
  port: 60686
  timeout_s: 1.5
  speed: [80, 80, 80, 80, 80]
  force: [50, 50, 50, 50, 50]
  running_time: [50, 50, 50, 50, 50]

control:
  command_rate_hz: 18.0
  min_send_interval_sec: 0.03
  idle_timeout_sec: 0.25
  send_on_change_only: true
  keepalive_sec: 1.0
  # input_mode: absolute | incremental
  # absolute: map encoder absolute value to joint angle directly
  # incremental: map encoder delta per frame to joint-angle increment
  # input_mode: incremental
  input_mode: absolute
  # For circular encoder values (0..360 style), wrap-aware delta unwrap.
  # If your source is already unwrapped/linear, set to 0.
  incremental_wrap_deg: 360.0
  # Ignore tiny encoder delta to avoid jitter-induced drift.
  incremental_deadband_deg: 0.6
  # Limit per-update joint increment after gain mapping.
  incremental_max_step_deg: 2.5
  # Ignore unrealistic one-frame encoder jumps.
  incremental_jump_guard_deg: 120.0
  busy_mode: false
  complete_pos_tol_deg: 2.0
  complete_vel_tol_deg_s: 3.0
  complete_stable_sec: 0.25
  busy_timeout_sec: 3.0
  append_retry_delay_sec: 0.15
  device_timeout_retry_delay_sec: 1.2
  max_consecutive_device_timeouts: 30
  recv_timeout_sec: 0.01
  median_window: 5
  input_deadband_deg: 2.5
  joint_deadband_deg: 0.45
  max_joint_speed_deg_s: 180.0

# SDK RM order:
# J1=侧摆, J2=拇指, J3=食指, J4=中指, J5=无名
# RPi channels from io_interface.py:
# Enc1=thumb_swing, Enc2=thumb_flex, Enc3=ring, Enc4=middle, Enc5=index
# NOTE:
# source_min/source_max are raw encoder range endpoints from RPi telemetry.
# They do NOT need to be physical 0-360 mechanical angles.
mapping:
  J1:
    source_channel: 1
    source_min: 0.0
    source_max: 360.0
    target_min_deg: -90.0
    target_max_deg: 90.0
    invert: false
  J2:
    source_channel: 2
    source_min: 0.0
    source_max: 360.0
    target_min_deg: -90.0
    target_max_deg: 90.0
    invert: false
  J3:
    source_channel: 5
    source_min: 0.0
    source_max: 360.0
    target_min_deg: -90.0
    target_max_deg: 90.0
    invert: false
  J4:
    source_channel: 4
    source_min: 0.0
    source_max: 360.0
    target_min_deg: -90.0
    target_max_deg: 90.0
    invert: false
  J5:
    source_channel: 3
    source_min: 0.0
    source_max: 360.0
    target_min_deg: -90.0
    target_max_deg: 90.0
    invert: false
